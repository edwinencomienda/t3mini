{
  "name": "t3-mini",
  "private": true,
  "packageManager": "bun@1.4.3",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "PORT=4016 T3_MINI_PHONE_PORT=4316 T3_MINI_TAILSCALE_PORT=8444 node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1 --port 4016",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "compile": "bun cli/compile.ts",
    "install-cli": "bun cli/install.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@base-ui/react": "1.8.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "^1.169.2",
    "dompurify": "3.4.16",
    "lucide-react": "latest",
    "mermaid": "12.2.0",
    "playwright-core": "1.63.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "wordlist-english": "1.2.1",
    "ws": "8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
